<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ref"
        Arguments=""
        InstallLocation="C:\Program Files\Jesús Espino\Kino Studio">
    </Installer>
    <PackageInformation
        PackageName="Kino Studio"
        PackageDisplayName="Kino Studio"
        PublisherName="CN=Jesús Espino"
        PublisherDisplayName="Jesús Espino"
        Version="0.1.0.0"
        PackageDescription="A ref application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.ref"
                Description="A ref application"
                DisplayName="Kino Studio"
                ExecutableName="ref"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Kino Studio</DisplayName>
            <PublisherDisplayName>Jesús Espino</PublisherDisplayName>
            <Description>A ref application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ref.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
