{
  "name": "kino",
  "version": "0.1.0",
  "description": "Describe explanatory animations as text, render them as video",
  "type": "module",
  "scripts": {
    "dev": "vite frontend",
    "build": "vite build frontend",
    "build:dev": "vite build frontend --minify false --mode development",
    "app": "wails3 task build",
    "app:dev": "wails3 task dev",
    "typecheck": "tsc --noEmit",
    "render": "tsx cli/render.ts",
    "check": "tsx cli/check.ts",
    "test": "tsx cli/smoke.ts",
    "tts": "tts/.venv/bin/python tts/server.py",
    "tts:setup": "tts/setup.sh"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.28.2",
    "opentype.js": "^1.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@twemoji/svg": "^15.0.0",
    "@wailsio/runtime": "3.0.0-beta.33",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "mp4-muxer": "^5.1.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.5",
    "zustand": "5.0.15"
  }
}
