{
  "name": "kino",
  "version": "0.1.0",
  "description": "Describe explanatory animations as text, render them as video",
  "type": "module",
  "scripts": {
    "dev": "vite web",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "render": "tsx cli/render.ts",
    "check": "tsx cli/check.ts",
    "test": "tsx cli/smoke.ts",
    "tts": "tts/.venv/bin/python tts/server.py",
    "tts:setup": "tts/setup.sh"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "opentype.js": "^1.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@twemoji/svg": "^15.0.0",
    "mp4-muxer": "^5.1.3"
  }
}
