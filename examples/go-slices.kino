// How Go slices work: a slice is a small header (ptr, len, cap)
// that points into a backing array.

video {
  size: (1280, 720)
  fps: 30
  theme: dark
  transition: 700ms
  hold: 1200ms
}


frame "title" (1500ms, ease-out, hold: 1800ms) {
  cover: title at center() {
    eyebrow: "Go internals"
    text: "How slices work"
    subtitle: "headers, backing arrays, and what append really does"
    size: 64
  }
}
frame "make" (fade, 600ms) {
  title: label at (640, 50) { text: "s := make([]int, 0, 4)", font: mono, size: 30, origin: top }
  s: struct at (90, 170) {
    title: "s  (slice header)"
    fields: { ptr: "•", len: 0, cap: 4 }
    size: 26
  }
  data: array at (470, 166) { label: "backing array", capacity: 4, cell: 76, size: 28 }
  ptr: s.ptr -> data[0]
}

step "append 1" {
  title.text = "s = append(s, 1)"
  data.push(1)
  s.len = 1
  s.highlight(len)
}

step "append 2, 3" {
  title.text = "s = append(s, 2, 3)"
  data.push(2, 3)
  s.len = 3
}

step "re-slice" {
  s.unhighlight()
  title.text = "t := s[1:3]"
  t: struct at below(s, 90) {
    title: "t"
    fields: { ptr: "•", len: 2, cap: 3 }
    size: 26
  }
  tptr: t.ptr -> data[1] { color: warn, curve: -0.2 }
  data.range(t, 1, 3, warn)
}

step "shared memory" {
  title.text = "t[0] = 99   // s[1] changes too!"
  data[1] = 99
  data.highlight(1, bad)
}

step "fill capacity" {
  data.unhighlight()
  title.text = "s = append(s, 4)   // len 4, cap 4"
  data.push(4)
  s.len = 4
}

step "grow" (900ms) {
  title.text = "s = append(s, 5)   // no room: allocate & copy"
  data2: array at (470, 450) { label: "new backing array", capacity: 8, cell: 76, size: 28 }
then
  data2.copyFrom(data)
then
  ptr.to = data2[0]
  ptr.curve = 0.25
  s { len: 5, cap: 8 }
  data2.push(5)
  data2.highlight(4, good)
}

step "t is not affected" (hold: 2500ms) {
  title.text = "s now has its own array; t still sees the old one"
  s.highlight(ptr, good)
  t.highlight(ptr, warn)
}
